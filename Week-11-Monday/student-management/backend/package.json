{
  "name": "student-backend",
  "version": "1.0.0",
  "description": "College Student Management System - Backend REST API with PostgreSQL and Integration Testing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/student.unit.test.js --runInBand",
    "test:integration": "jest tests/student.integration.test.js --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "keywords": [
    "express",
    "postgresql",
    "jest",
    "supertest",
    "integration-testing",
    "devops"
  ],
  "author": "Student Management System",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "models/**/*.js",
      "routes/**/*.js",
      "app.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "clover"
    ]
  }
}
