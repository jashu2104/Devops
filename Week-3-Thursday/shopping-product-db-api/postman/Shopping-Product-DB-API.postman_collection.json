{
  "info": {
    "_postman_id": "shopping-product-db-api-collection-id",
    "name": "Online Shopping Product Database API",
    "description": "Postman Collection for B.Tech DevOps & FullStack Assignment 3.1.2 - Online Shopping Product Database Management using Express, PostgreSQL, and Sequelize ORM.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Success is true\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.success).to.eql(true);",
              "    pm.expect(data.database).to.eql(\"PostgreSQL\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Mechanical Keyboard\",\n    \"category\": \"Electronics\",\n    \"price\": 2500,\n    \"stock\": 20\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Product created\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.success).to.eql(true);",
              "});",
              "const response = pm.response.json();",
              "if (response.data && response.data.id) {",
              "    pm.environment.set(\"productId\", response.data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get All Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Success is true\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.success).to.eql(true);",
              "    pm.expect(data.data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Product By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Success is true\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Search by Category",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?category=Electronics",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            {
              "key": "category",
              "value": "Electronics"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Filtered results returned\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.success).to.eql(true);",
              "    pm.expect(data.data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Sort by Price",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?sort=price",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            {
              "key": "sort",
              "value": "price"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Products sorted by price\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Combined Query (Category & Sort)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?category=Electronics&sort=price",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            {
              "key": "category",
              "value": "Electronics"
            },
            {
              "key": "sort",
              "value": "price"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Filtered & sorted results returned\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Product Price",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"price\": 2800\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Product updated\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Product deleted\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Validation Error (Invalid Data)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"\",\n    \"category\": \"\",\n    \"price\": -500,\n    \"stock\": -10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Validation messages returned\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.success).to.eql(false);",
              "    pm.expect(data.errors).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Product Not Found",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/9999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "9999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test(\"Error message returned\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.success).to.eql(false);",
              "    pm.expect(data.message).to.eql(\"Product not found\");",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
